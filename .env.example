# Bu dosyayı .env olarak kopyalayıp kendi değerlerinle doldur.
# .env asla Git'e commit edilmemeli.

# === SUNUCU AYARLARI ===
PORT=4000
# Güvenlik: localhost veya production URL'i belirt (varsayılan: http://localhost:4000)
CORS_ORIGIN=http://localhost:4000
# Node ortamı: 'development' veya 'production'
NODE_ENV=development

# === SUPER ADMIN KURULUMU ===
# İlk kurulumda otomatik oluşturulacak Super Admin hesabı
# (yalnızca hiç kullanıcı yoksa kullanılır — sonra panelden değiştirilmelidir!)
# Render, GitHub Actions vb. CI/CD ortamlarından gelen env vars kullanılır
# SUPER_ADMIN_EMAIL ve SUPER_ADMIN_PASSWORD GitHub Secrets'ten ayarlanmalıdır
SUPER_ADMIN_EMAIL=admin@dersbul.com
SUPER_ADMIN_PASSWORD=GucluBirSifre123!Degistir

# === OTURUM AYARLARI ===
# Oturum (session) token'larının geçerlilik süresi (saat)
SESSION_TTL_HOURS=168

# === VERİTABANI ===
# Veritabanı dosya yolu (opsiyonel, varsayılan: backend/data/dersbul.db)
# DB_PATH=./backend/data/dersbul.db

# === İLETİŞİM AYARLARI ===
# Ana sayfadaki WhatsApp hattı. Boş kalırsa iletişim alanı "yakında" gösterir.
# WHATSAPP_NUMBER=905xxxxxxxxx
# WHATSAPP_LABEL=WhatsApp üzerinden bize yazın

# === GÜNLÜK (LOG) AYARLARI ===
# Hata loglarının saklanması: 'file' (disk) veya 'db' (veritabanı)
ERROR_LOG_TYPE=file
# Üretim ortamında sadece kritik hatalar loglanır
LOG_LEVEL=info
